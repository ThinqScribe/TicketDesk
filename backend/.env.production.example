# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to git!

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string from your hosting provider
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/ticketdesk

# ── Application ───────────────────────────────────────────────────────────
DEBUG=false
API_PREFIX=/api

# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-generate-with-openssl

# Your production frontend URL
FRONTEND_URL=https://yourdomain.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Authentication ────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email Service (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_INBOUND_SECRET=your-inbound-webhook-secret
INBOUND_EMAIL_DOMAIN=mail.yourdomain.com

# ── Stripe Payments ───────────────────────────────────────────────────────
# Use LIVE mode keys for production!
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_PUBLIC_KEY=pk_live_your_live_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret
STRIPE_PAID_PRICE_ID=price_your_live_price_id

# ── Redis (Rate Limiting) ─────────────────────────────────────────────────
# Redis connection string from your hosting provider
REDIS_URL=redis://default:password@host:6379

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_FREE=100
RATE_LIMIT_PAID=1000
