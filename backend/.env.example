# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your development values

# ── Database ──────────────────────────────────────────────────────────────
# SQLite for local development (no setup required)
DATABASE_URL=sqlite:///./database.db

# ── Application ───────────────────────────────────────────────────────────
DEBUG=true
API_PREFIX=/api

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Your local frontend URL
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email Service (Resend) ────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_test_your_test_key_here
RESEND_FROM_EMAIL=noreply@localhost
RESEND_INBOUND_SECRET=
INBOUND_EMAIL_DOMAIN=

# ── Stripe Payments ───────────────────────────────────────────────────────
# Use TEST mode keys for development
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLIC_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret
STRIPE_PAID_PRICE_ID=price_test_your_price_id

# ── Redis (Rate Limiting) ─────────────────────────────────────────────────
# Optional for local development
REDIS_URL=redis://localhost:6379/0

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_FREE=100
RATE_LIMIT_PAID=1000

# ── Error Monitoring ──────────────────────────────────────────────────────
# Leave empty for local development
SENTRY_DSN=
